{
  "name": "bible-app",
  "compatibility_date": "2026-08-22",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bible-app-db",
      "database_id": "7c7e15bb-b35a-415e-b3fa-d10b13e461b9"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
