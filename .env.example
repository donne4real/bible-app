# Environment Variables
# Copy this file to .env and fill in your values

# Gemini API Key (optional - for AI features)
GEMINI_API_KEY=""

# App URL (optional)
APP_URL=""

# API Base URL (optional)
VITE_API_BASE_URL=""

# API Bible Key (required for licensed translations: NLT, AMP, NIV)
# Get your key at: https://scripture.api.bible/
API_BIBLE_KEY=""

# To re-download/refresh the Bible data, run:
#   node scripts/download-bibles.mjs
